(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.2mm))
)
(rule "Copper to edge clearance 1"
	(constraint edge_clearance (min 0.8mm))
)
(rule "Courtyard clearance 1"
	(constraint courtyard_clearance (min 0.3mm))
)
(rule "Physical clearance 1"
	(constraint physical_clearance (min 0.2mm))
)
(rule "Creepage distance 1"
	(constraint creepage (min 0.3mm))
)
(rule "Copper to hole clearance 1"
	(constraint hole_clearance (min 0.15mm))
)
(rule "Minimum connection width 1"
	(constraint connection_width (min 0.15mm))
)
(rule "Minimum annular width 1"
	(constraint annular_width (min 0.15mm))
)
(rule "Soldermask expansion 1"
	(constraint solder_mask_expansion (min 0.05mm))
)
(rule "Minimum drill size 1"
	(constraint hole_size (min 0.3mm))
)
(rule "Routing width 1"
	(constraint track_width (min 0.4mm) (opt 0.6mm) (max 0.8mm))
)
(rule "Vias under SMD 1"
	(constraint disallow via)
	(condition "A.Pad_Type == 'SMD'")
)
